# App
GHOSTINDEX_SECRET_KEY=
GHOSTINDEX_HOST=0.0.0.0
GHOSTINDEX_PORT=8787
GHOSTINDEX_KEEP_ADMIN=false

# SQLite by default: data/ghostindex.db
# GHOSTINDEX_DATABASE_URL=sqlite:///./data/ghostindex.db

# SMTP (optional, for email alerts)
GHOSTINDEX_SMTP_HOST=
GHOSTINDEX_SMTP_PORT=587
GHOSTINDEX_SMTP_USER=
GHOSTINDEX_SMTP_PASSWORD=
GHOSTINDEX_SMTP_FROM=
GHOSTINDEX_SMTP_TLS=true

# Wayback politeness
GHOSTINDEX_WAYBACK_DELAY_MS=400

# LLM: глобальная очередь — один запрос к модели за раз (файл data/.llm.lock)

# BBOT OSINT (pipx install bbot)
# GHOSTINDEX_BBOT_BIN=bbot
# GHOSTINDEX_BBOT_FLAGS=subdomain-enum,email-enum,cloud-enum,web-basic
# GHOSTINDEX_BBOT_MODULES=http,portscan,gowitness,nuclei
# GHOSTINDEX_BBOT_OUTPUT_MODULES=csv,json,txt,subdomains,emails
# GHOSTINDEX_BBOT_TIMEOUT_SECONDS=7200
# GHOSTINDEX_BBOT_ALLOW_DEADLY=true
